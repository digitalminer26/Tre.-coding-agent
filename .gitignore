node_modules/
dist/
.history/
context-fold/
# Local PTY repro scratch (mock endpoint, capture logs, sessions) — never in git.
.repro/
# Per-machine endpoint config (baseUrl + apiKey) — never in git.
# Copy models.json.example to models.json and fill it in (or run tre. with no
# models.json: it prints a step-by-step setup guide).
models.json
# Per-deployment durable extra roots (C36) — local to this machine, never in
# git. Copy the shape from docs/05-extra-roots-spec.md:
#   { "extraRoots": [ "/abs/or/~/relative/dir", ... ] }
tre.json
# Telegram bot credentials (token) + poll state. C40 moved these to the
# MACHINE level (~/.tre/telegram.json + ~/.tre/telegram/) — outside the repo,
# so they never enter git. The entries below are a legacy safety net for any
# stale workspace-local copy.
.tre/telegram.json
.tre/telegram/
# Parallel-delegation skill state (plan files, prompts, logs, sessions) —
# local orchestration artifacts, never in git.
.tre/delegation/
# Implement-audit skill state (plan, prompts, audit reports, logs, sessions) —
# local orchestration artifacts, never in git.
.tre/implement-audit/
# Audit-cycle orchestration state (auditor prompts, raw reports, stderr logs) —
# local artifacts, never in git. The consolidated human report (.mcp-audit-*.md)
# IS committed, matching the cycle-1/2 convention.
.tre/audit-cycle3/
# Read-only doc/code audit rounds (auditor prompts, verdicts, session
# transcripts) — same class of local orchestration artifacts.
.tre/audits/
# Per-cycle audit scratch (reproducers, findings notes, kick scripts) —
# findings are pinned as named regression tests; scratch stays local.
.tre/a[0-9]-*.mjs
.tre/a[0-9]-*.md
.tre/a[0-9]-kick.sh
# GitHub push token. The machine-level home is ~/.tre/github-token (outside
# the repo, never in git). This entry is a legacy safety net for the old
# repo-local location, still honored by the release tooling as a fallback.
.tre/github-token
# Skills are deployment-specific — never in git by default. The two
# exceptions are the repo's own development protocol (force-added):
.tre/skills/
!.tre/skills/git-commit/
!.tre/skills/self-improve/

# editor swap files
.*.swp
*.swp

# tre-deploy skill build output (offline tarballs) — never in git.
.tre/deploy-out/

# worker scratch files (gate/build output) — never in git.
.gate.out
.build.out
# measurement scratch space for guard audits — never in git.
.audit-tmp/
# P7 R4–R8 audit-cycle scratch (adversarial repro harnesses, test/build logs,
# leaked-fixture cleanup) — repros are cited by path in docs/11 §11.1 but the
# scripts themselves are workspace scratch, not project history.
.tre/tmp/
# Audit verification harness scratch (e.g. p7-audit-verify.ts) — same policy.
.tre/audit/
# Auditor-cycle scratch (probe scripts, gate/build logs, tmp fixtures) —
# cited by path in audit reports, never project history. Same policy.
scratch/
# Raw auditor transcript recovery dumps (KB-scale raw thinking logs; the
# consolidated reports audit-cycle*-resolutions/-review.md ARE committed).
.tre/audit-cycle*recovered.md

# P3b audit-cycle raw transcripts (128KB reasoning dumps; prompts + final verdicts live in docs/audits/)
docs/audits/audit-p3b-c[0-9].txt
docs/audits/audit-c*.log

# Adversarial-audit scratch (probes, repro harnesses) — never in git.
.probe/
.tre/audit-p11/
.probe/
.tre/audit-p11/
# Round-scoped adversarial probe harnesses (@ts-nocheck repro scripts) —
# findings are pinned as named regression tests; the probes themselves are scratch.
test/probes/
# P15 cycle-A4/A5 audit probes (F1–F6, R1 repro harnesses, debug scripts) —
# findings pinned as named regression tests (A4-*/A5-*); probes are scratch.
.tre/*audit*.mjs
.tre/*-fix.mjs
.tre/dbg-a5.mjs
.tre/p15-reprobe.mjs
# Cycle-A6 audit probes (kept on disk for citation, never in git).
.tre/a6-*

# P9 acceptance-audit scratch (reviewer prompts/logs/sessions/pids) —
# findings are pinned as named regression tests; the rounds themselves are scratch.
.scratch/
# P14-era gate/test logs + the P15 reprobe script were force-added before the
# logs-are-scratch policy settled — untracked (git rm --cache) and kept on
# disk; same policy as .tre/tmp/. Consolidated human review reports
# (audit-*-review.md, remaining-items-review.md) stay tracked as history.
.tre/p14-*.log
.tre/qg-p14*.log
.tre/p15-reprobe.mjs
# P18/P19 audit test-run logs (scratch; findings live in the audit .md files and named tests).
.tre/*audit*.log
