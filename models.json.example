{
  "default": "<model-id>",
  "models": [
    {
      "id": "<model-id>",
      "provider": "<provider-label>",
      "baseUrl": "http://<host>:<port>/v1",
      "api": "openai-completions",
      "apiKey": "not-needed",
      "contextWindow": 131072,
      "maxTokens": 32768,
      "compactionReserve": 16384,
      "temperature": 0.6
    },
    {
      "id": "<chatgpt-model-id>",
      "provider": "chatgpt",
      "baseUrl": "https://api.openai.com/v1",
      "api": "openai-responses",
      "auth": "chatgpt-oauth",
      "contextWindow": 200000,
      "maxTokens": 32768,
      "temperature": 0.6
    },
    {
      "id": "<vendor/model-id>",
      "provider": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "api": "openai-completions",
      "apiKey": "sk-or-...",
      "contextWindow": 200000,
      "maxTokens": 8192,
      "headers": {
        "X-Title": "tre.",
        "HTTP-Referer": "https://github.com/digitalminer26/Tre.-coding-agent"
      },
      "compat": {
        "extraParams": {
          "provider": { "order": ["<preferred-provider>"] },
          "reasoning": { "effort": "medium" }
        }
      }
    }
  ]
}
