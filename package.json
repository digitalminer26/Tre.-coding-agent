{
  "name": "coding-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "coding-agent": "dist/src/cli/main.js"
  },
  "description": "A small, fully-owned coding agent: TypeScript harness talking to OpenAI-compatible LLM endpoints. Built from scratch, pi as design reference (see PLAN.md).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "eval": "tsc && node dist/test/eval-run.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cli-truncate": "^6.1.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "wrap-ansi": "^10.0.1"
  }
}
