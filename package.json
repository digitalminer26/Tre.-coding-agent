{
  "name": "tre-coding-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "tre.": "dist/src/cli/main.js",
    "coding-agent": "dist/src/cli/main.js"
  },
  "description": "Tre Coding Agent — a small, fully-owned coding agent: TypeScript harness talking to OpenAI-compatible LLM endpoints. Built from scratch, pi as design reference (see PLAN.md). Invoke as `tre.` (coding-agent is a legacy alias).",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "check": "sh scripts/quality-check.sh",
    "test": "sh scripts/quality-check.sh && tsc && node --test dist/test/*.test.js",
    "eval": "tsc && node dist/test/eval-run.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cli-truncate": "^6.1.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "wrap-ansi": "^10.0.1"
  }
}
